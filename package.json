{
  "name": "mailcowui-ng",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile-first web app for mailcow-dockerized, built on mailcow REST API v2",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev/with-mock.mjs dev",
    "build": "vite build",
    "preview": "vite preview",
    "preview:mock": "node scripts/dev/with-mock.mjs preview",
    "mock:server": "tsx --tsconfig tsconfig.vitest.json tests/mocks/server.ts",
    "mock:scenario": "tsx --tsconfig tsconfig.vitest.json tests/mocks/scenario-url.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test --project=mobile-chromium --project=desktop-chromium --project=mobile-webkit",
    "test:smoke": "playwright test --project=smoke",
    "contract:generate": "node scripts/contract/generate.mjs",
    "contract:check": "node scripts/contract/check.mjs",
    "i18n:snapshot": "node scripts/i18n/refresh-snapshot.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "audit": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=critical",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "lhci": "node scripts/run-lhci.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tanstack/vue-query": "5.104.5",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@intlify/unplugin-vue-i18n": "11.2.7",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-msw": "2.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
